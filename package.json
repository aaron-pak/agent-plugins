{
  "name": "agent-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "postinstall": "effect-tsgo patch --tsrs --no-typescript",
    "build": "bun scripts/build.ts",
    "dev:artifact": "bun --cwd plugins/artifact-design/src --watch server.ts",
    "drift": "bun scripts/claude-code-drift.ts",
    "fmt": "bun fmt --no-script plugins/artifact-design/src plugins/artifact-design/tests scripts vitest.config.ts",
    "lint": "bun fmt --no-script --check plugins/artifact-design/src plugins/artifact-design/tests scripts vitest.config.ts && oxlint --type-aware --deny-warnings plugins/artifact-design/src plugins/artifact-design/tests scripts vitest.config.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p plugins/artifact-design --noEmit",
    "test": "vitest run",
    "mod": "bun scripts/mod/cli.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2",
    "marked": "16.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "acorn": "8.18.0",
    "ink": "8.0.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright-core": "1.56.1",
    "react": "19.2.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "5.1.0"
  }
}
