#!/usr/bin/env python3
"""pstack helper for the parts that differ between agent harnesses.

  pstack models get ROLE [--default]  model value for a role (config line, else default)
  pstack models show [--json]         every role with its value, default, and source
  pstack models detect [--json]       models reachable from the CLIs on this machine
  pstack models probe SLUG...         confirm each slug starts, at its effort, through its CLI
  pstack models path                  the config file path
  pstack seat SLUG --prompt-file F --out F [--read-only] [--cwd DIR] [--dry-run]
                                      run one seat through the CLI of the slug's family
  pstack transcripts list [--cwd DIR] [--harness H] [--kind K] [--since DAYS]
                          [--limit N] [--all-workspaces] [--paths]
  pstack transcripts current          this chat's transcript, from the harness's session id
  pstack transcripts show FILE [--tools] [--max-chars N]
  pstack store [--cwd DIR]            state directory for this repository (created)

Standard library only.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

HOME = Path.home()

CODE = "gpt-6.1-sol-xhigh"
JUDGMENT = "claude-opus-5-5-xhigh"
PANEL = f"{JUDGMENT}, {CODE}"

DEFAULTS: dict[str, str] = {
    "feature, refactoring": CODE,
    "bug-fix": CODE,
    "perf-issue": CODE,
    "hillclimb": CODE,
    "judgment and prose": JUDGMENT,
    "hardest tasks": JUDGMENT,
    "how explorer": CODE,
    "how explainer": JUDGMENT,
    "why investigators": CODE,
    "why synthesizer": JUDGMENT,
    "reflect tooling": CODE,
    "reflect judgment, divergent, synthesizer": JUDGMENT,
    "arena runners": PANEL,
    "arena cross-judge pool": PANEL,
    "swarm workers": CODE,
    "architect runners": PANEL,
    "interrogate reviewers": PANEL,
}

ALIASES = {"inherit-parent", "auto"}
EFFORTS = ["low", "medium", "high", "xhigh", "max", "ultra"]
CLAUDE_EFFORTS = ["low", "medium", "high", "xhigh", "max"]


def fail(message: str, code: int = 2) -> None:
    print(f"pstack: {message}", file=sys.stderr)
    sys.exit(code)


def warn(message: str) -> None:
    print(f"pstack: {message}", file=sys.stderr)


# Models ---------------------------------------------------------------------

def config_path() -> Path:
    override = os.environ.get("PSTACK_MODELS")
    if override:
        return Path(override).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
    return base / "pstack" / "models"


def read_config() -> tuple[dict[str, str], str | None]:
    path = config_path()
    if not path.is_file():
        return {}, None
    roles: dict[str, str] = {}
    budget = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if line.startswith("# budget:"):
            budget = line.removeprefix("# budget:").strip()
            continue
        if not line or line.startswith("#") or ":" not in line:
            continue
        label, value = line.split(":", 1)
        roles[label.strip()] = value.strip()
    return roles, budget


def role_names(label: str) -> set[str]:
    """Every spelling that names this role.

    "feature, refactoring" answers to "refactoring". "reflect judgment,
    divergent, synthesizer" answers to "reflect divergent", not "divergent".
    """
    parts = [part.strip() for part in label.split(",")]
    first = parts[0].split()
    if len(first) == 1:
        return {label, *parts}
    return {label, parts[0], *(f"{first[0]} {part}" for part in parts[1:])}


def resolve_role(query: str) -> str:
    wanted = " ".join(query.lower().split())
    matches = [label for label in DEFAULTS if wanted in role_names(label)]
    if len(matches) == 1:
        return matches[0]
    if matches:
        fail(f"{query!r} names several roles: {'; '.join(matches)}")
    fail(f"unknown role {query!r}. Roles: {'; '.join(DEFAULTS)}")
    raise AssertionError


@dataclass(frozen=True)
class Slug:
    text: str
    model: str
    effort: str | None
    fast: bool

    @property
    def family(self) -> str:
        return self.model.split("-", 1)[0]


def parse_slug(text: str) -> Slug:
    tokens = text.strip().split("-")
    fast = tokens[-1] == "fast"
    if fast:
        tokens = tokens[:-1]
    effort = tokens[-1] if tokens[-1] in EFFORTS else None
    if effort:
        tokens = tokens[:-1]
    return Slug(text=text.strip(), model="-".join(tokens), effort=effort, fast=fast)


def cmd_models(args: argparse.Namespace) -> None:
    if args.action == "path":
        print(config_path())
        return
    if args.action == "get":
        label = resolve_role(" ".join(args.role))
        roles, _ = read_config()
        print(DEFAULTS[label] if args.default else roles.get(label, DEFAULTS[label]))
        return
    if args.action == "show":
        roles, budget = read_config()
        rows = [
            {"role": label, "value": roles.get(label, default), "default": default,
             "source": "config" if label in roles else "default"}
            for label, default in DEFAULTS.items()
        ]
        retired = sorted(set(roles) - set(DEFAULTS))
        if args.json:
            print(json.dumps({"config": str(config_path()), "budget": budget,
                              "roles": rows, "retired": retired}, indent=2))
            return
        print(f"# config: {config_path()}{'' if config_path().is_file() else ' (absent)'}")
        print(f"# budget: {budget or 'none recorded (defaults are large, xhigh)'}")
        for row in rows:
            note = "default" if row["source"] == "default" else f"config, default {row['default']}"
            print(f"{row['role']}: {row['value']}    [{note}]")
        for label in retired:
            print(f"# retired role in config, drop it: {label}")
        return
    if args.action == "detect":
        found = detect_models()
        if args.json:
            print(json.dumps(found, indent=2))
            return
        for family, models in found.items():
            if isinstance(models, str):
                print(f"{family}: {models}")
                continue
            for model, efforts in models.items():
                print(f"{model}: {' '.join(efforts)}")
        return
    if args.action == "probe":
        if not args.role:
            fail("models probe needs at least one SLUG")
        bad = 0
        for text in args.role:
            ok, detail = probe(parse_slug(text))
            bad += not ok
            print(f"{'ok  ' if ok else 'FAIL'} {text}{'' if ok else '  ' + detail}")
        sys.exit(1 if bad else 0)


def codex_models() -> dict[str, list[str]] | str:
    if not shutil.which("codex"):
        return "codex CLI not installed"
    try:
        out = subprocess.run(["codex", "debug", "models"], capture_output=True,
                             text=True, timeout=60).stdout
        data = json.loads(out[out.index("{"):])
        return {m["slug"]: [e["effort"] for e in m.get("supported_reasoning_levels", [])]
                for m in data.get("models", []) if m.get("visibility") == "list"}
    except (subprocess.SubprocessError, ValueError, KeyError) as error:
        return f"codex is installed but `codex debug models` failed: {error}"


def detect_models() -> dict[str, object]:
    return {
        "gpt": codex_models(),
        "claude": (
            "the claude CLI has no model list. Use your harness's list (Claude Code Agent "
            "aliases, T3 orchestrator_capabilities) and confirm ids with `pstack models probe`. "
            f"Claude efforts: {' '.join(CLAUDE_EFFORTS)}"
            if shutil.which("claude") else "claude CLI not installed"
        ),
    }


def probe(slug: Slug) -> tuple[bool, str]:
    if slug.text in ALIASES:
        return True, ""
    if slug.family == "gpt" and slug.effort:
        levels = codex_models()
        if isinstance(levels, dict):
            if slug.model not in levels:
                return False, f"codex does not list {slug.model}"
            if slug.effort not in levels[slug.model]:
                return False, f"{slug.model} supports {' '.join(levels[slug.model])}"
    if slug.family == "claude" and slug.effort and slug.effort not in CLAUDE_EFFORTS:
        return False, f"claude efforts are {' '.join(CLAUDE_EFFORTS)}"
    with tempfile.TemporaryDirectory() as scratch:
        prompt = Path(scratch) / "prompt.md"
        prompt.write_text("Reply with exactly: ok")
        out = Path(scratch) / "out.md"
        try:
            command = seat_command(slug, read_only=True, cwd=Path(scratch), out=out, ephemeral=True)
        except SystemExit:
            return False, f"no CLI runner for the {slug.family} family"
        try:
            result = subprocess.run(command, input=prompt.read_text(), capture_output=True,
                                    text=True, timeout=240, cwd=scratch, env=seat_env())
        except subprocess.TimeoutExpired:
            return False, "timed out"
        reply = read_reply(slug, result.stdout, out)[0]
        ok = result.returncode == 0 and "ok" in reply.lower()
        return ok, (result.stderr or result.stdout).strip()[-300:]


# Seats ----------------------------------------------------------------------

READ_ONLY_NOTE = ("You are a read-only seat. Do not edit files, commit, push, or run "
                  "commands that change state. Report findings only.\n\n")


def seat_command(slug: Slug, read_only: bool, cwd: Path, out: Path,
                 ephemeral: bool = False) -> list[str]:
    if slug.family == "claude":
        command = ["claude", "-p", "--model", slug.model, "--output-format", "json",
                   "--permission-mode", "auto"]
        if slug.effort:
            command += ["--effort", slug.effort]
        if read_only:
            command += ["--disallowedTools", "Edit,Write,NotebookEdit"]
        if ephemeral:
            command += ["--no-session-persistence"]
        if slug.fast:
            warn(f"{slug.text}: the claude CLI has no fast tier flag, running at normal speed")
        return command + shlex.split(os.environ.get("PSTACK_CLAUDE_ARGS", ""))
    if slug.family == "gpt":
        command = ["codex", "exec", "--json", "--skip-git-repo-check", "-m", slug.model,
                   "-C", str(cwd), "-o", str(out)]
        if read_only:
            command += ["-s", "read-only"]
        else:
            command += ["-s", "workspace-write", "-c", "sandbox_workspace_write.network_access=true"]
        if slug.effort:
            command += ["-c", f"model_reasoning_effort={slug.effort}"]
        if slug.fast:
            command += ["-c", "service_tier=priority"]
        if ephemeral:
            command += ["--ephemeral"]
        return command + shlex.split(os.environ.get("PSTACK_CODEX_ARGS", "")) + ["-"]
    fail(f"no CLI runner for the {slug.family!r} family ({slug.text}). "
         "Spawn it with your harness's native subagent tool or pick another model.")
    raise AssertionError


PARENT_SESSION_VARS = ("CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ID",
                       "CODEX_THREAD_ID", "CODEX_SESSION_ID")


def seat_env() -> dict[str, str]:
    """The parent's environment without the variables that name the parent's session.

    A seat is its own session. Inheriting these would label it as the parent's
    entrypoint and make `transcripts current` inside it point at the parent.
    """
    return {k: v for k, v in os.environ.items() if k not in PARENT_SESSION_VARS}


def read_reply(slug: Slug, stdout: str, out: Path) -> tuple[str, str | None]:
    """The seat's final message and its session id."""
    if slug.family == "claude":
        try:
            data = json.loads(stdout)
        except ValueError:
            return stdout, None
        return str(data.get("result", "")), data.get("session_id")
    session = None
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") == "thread.started":
            session = event.get("thread_id")
            break
    return (out.read_text() if out.is_file() else ""), session


def resume_hint(slug: Slug, session: str) -> str:
    if slug.family == "claude":
        return f"claude -p --resume {session} --model {slug.model}"
    return f"codex exec resume {session}"


def cmd_seat(args: argparse.Namespace) -> None:
    slug = parse_slug(args.slug)
    if slug.text in ALIASES:
        fail("inherit-parent and auto mean the parent chat model. Spawn natively without a model.")
    prompt = Path(args.prompt_file).read_text()
    if args.read_only:
        prompt = READ_ONLY_NOTE + prompt
    out = Path(args.out).resolve()
    cwd = Path(args.cwd or os.getcwd()).resolve()
    command = seat_command(slug, args.read_only, cwd, out)
    if args.dry_run:
        print(shlex.join(command))
        return
    result = subprocess.run(command, input=prompt, text=True, cwd=cwd, env=seat_env(),
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    reply, session = read_reply(slug, result.stdout, out)
    out.write_text(reply)
    if session:
        meta = {"slug": slug.text, "session": session, "resume": resume_hint(slug, session)}
        Path(f"{out}.session.json").write_text(json.dumps(meta, indent=2) + "\n")
        warn(f"seat session {session}. Resume with: {meta['resume']}")
    if result.returncode:
        sys.stderr.write(result.stderr[-4000:])
        sys.exit(result.returncode)


# Transcripts ----------------------------------------------------------------

def dash_slug(path: Path) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


@dataclass
class Transcript:
    harness: str
    kind: str
    path: Path

    @property
    def mtime(self) -> float:
        return self.path.stat().st_mtime


def first_record(path: Path) -> dict:
    try:
        with path.open() as handle:
            for line in handle:
                if line.strip():
                    return json.loads(line)
    except (OSError, ValueError):
        pass
    return {}


def claude_kind(path: Path) -> str:
    try:
        with path.open() as handle:
            for _, line in zip(range(50), handle):
                match = re.search(r'"entrypoint":"([a-z-]+)"', line)
                if match:
                    return "headless" if match.group(1) == "sdk-cli" else "session"
    except OSError:
        pass
    return "session"


def claude_transcripts(cwds: list[Path] | None) -> list[Transcript]:
    root = HOME / ".claude" / "projects"
    if cwds is None:
        dirs = [d for d in root.glob("*") if d.is_dir()]
    else:
        dirs = list(dict.fromkeys(root / dash_slug(c) for c in cwds))
    found: list[Transcript] = []
    for d in dirs:
        found += [Transcript("claude", claude_kind(p), p) for p in d.glob("*.jsonl")]
        found += [Transcript("claude", "subagent", p) for p in d.glob("*/subagents/*.jsonl")]
    return found


def codex_kind(meta: dict) -> str:
    source = meta.get("source")
    if isinstance(source, dict) and "subagent" in source:
        return "subagent"
    return "headless" if source == "exec" else "session"


def codex_transcripts(cwds: list[Path] | None) -> list[Transcript]:
    found: list[Transcript] = []
    wanted = {str(c) for c in cwds} if cwds is not None else None
    for p in (HOME / ".codex" / "sessions").glob("*/*/*/rollout-*.jsonl"):
        meta = first_record(p).get("payload", {})
        if wanted is not None:
            cwd = meta.get("cwd")
            if not cwd or str(Path(cwd).resolve()) not in wanted:
                continue
        found.append(Transcript("codex", codex_kind(meta), p))
    return found


def cursor_slug(path: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", path).strip("-")


def cursor_transcripts(cwds: list[Path] | None) -> list[Transcript]:
    root = HOME / ".cursor" / "projects"
    if cwds is None:
        dirs = list(root.glob("*/agent-transcripts"))
    else:
        dirs = list(dict.fromkeys(root / cursor_slug(str(c)) / "agent-transcripts" for c in cwds))
    found: list[Transcript] = []
    for d in dirs:
        found += [Transcript("cursor", "session", p) for p in d.glob("*.jsonl")]
        found += [Transcript("cursor", "session", p) for p in d.glob("*/*.jsonl")]
        found += [Transcript("cursor", "subagent", p) for p in d.glob("*/subagents/*.jsonl")]
    return found


SOURCES = {"claude": claude_transcripts, "codex": codex_transcripts, "cursor": cursor_transcripts}


def workspace_paths(raw: str) -> list[Path]:
    """The workspace as typed and as resolved. Harnesses key on either."""
    typed = Path(os.path.abspath(os.path.expanduser(raw)))
    return list(dict.fromkeys([typed, typed.resolve()]))


def first_prompt(t: Transcript) -> str:
    for role, text in turns(t, tools=False, max_chars=0):
        if role == "user":
            return " ".join(text.split())[:100]
    return ""


def guess_harness(path: Path) -> str:
    text = str(path)
    if "/.codex/" in text:
        return "codex"
    if "/.cursor/" in text:
        return "cursor"
    return "claude"


def cmd_transcripts(args: argparse.Namespace) -> None:
    if args.action == "show":
        if not args.file:
            fail("transcripts show needs a FILE")
        path = Path(args.file).expanduser().resolve()
        t = Transcript(guess_harness(path), "session", path)
        for role, text in turns(t, tools=args.tools, max_chars=args.max_chars):
            print(f"## {role}\n{text}\n")
        return
    if args.action == "current":
        path = current_transcript()
        if not path:
            fail("no session id from this harness (Claude Code sets CLAUDE_CODE_SESSION_ID, "
                 "Codex sets CODEX_THREAD_ID). In Cursor, use the newest `session` entry of "
                 "`transcripts list --harness cursor` and confirm it by its first prompt.", 1)
        print(path)
        return
    cwds = None if args.all_workspaces else workspace_paths(args.cwd or os.getcwd())
    harnesses = list(SOURCES) if args.harness == "all" else [args.harness]
    found = [t for h in harnesses for t in SOURCES[h](cwds)]
    if args.kind != "all":
        found = [t for t in found if t.kind == args.kind]
    if args.since:
        cutoff = time.time() - args.since * 86400
        found = [t for t in found if t.mtime >= cutoff]
    found.sort(key=lambda t: t.mtime, reverse=True)
    shown = found if args.limit == 0 else found[: args.limit]
    for t in shown:
        if args.paths:
            print(t.path)
            continue
        stamp = datetime.fromtimestamp(t.mtime).strftime("%Y-%m-%d %H:%M")
        print(f"{stamp}\t{t.harness}\t{t.kind}\t{t.path}\t{first_prompt(t)}")
    if len(shown) < len(found):
        warn(f"{len(found) - len(shown)} older transcripts not shown. Pass --limit 0 or --since DAYS.")


def current_transcript() -> Path | None:
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if session:
        matches = list((HOME / ".claude" / "projects").glob(f"*/{session}.jsonl"))
        if matches:
            return matches[0]
    thread = os.environ.get("CODEX_THREAD_ID")
    if thread:
        matches = list((HOME / ".codex" / "sessions").glob(f"*/*/*/rollout-*-{thread}.jsonl"))
        if matches:
            return matches[0]
    return None


NOISE = re.compile(r"^\s*(<(environment_context|user_instructions|external_[a-z_]+|system-reminder|"
                   r"command-[a-z-]+|local-command-[a-z]+)\b|# AGENTS\.md instructions)")


def clip(text: str, max_chars: int) -> str:
    if max_chars and len(text) > max_chars:
        return f"{text[:max_chars]} [... {len(text) - max_chars} more chars]"
    return text


def blocks_text(content: object, tools: bool, max_chars: int) -> list[tuple[str, str]]:
    if isinstance(content, str):
        return [("text", content)]
    pieces: list[tuple[str, str]] = []
    for block in content if isinstance(content, list) else []:
        kind = block.get("type")
        if kind in ("text", "input_text", "output_text"):
            pieces.append(("text", block.get("text", "")))
        elif tools and kind == "tool_use":
            pieces.append(("tool", clip(f"{block.get('name')}: {json.dumps(block.get('input'))}", max_chars)))
        elif tools and kind == "tool_result":
            body = block.get("content")
            if isinstance(body, list):
                body = "\n".join(b.get("text", "") for b in body if isinstance(b, dict))
            pieces.append(("tool result", clip(str(body), max_chars)))
    return pieces


def turns(t: Transcript, tools: bool, max_chars: int):
    try:
        handle = t.path.open()
    except OSError:
        return
    with handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            yield from record_turns(t.harness, record, tools, max_chars)


def record_turns(harness: str, record: dict, tools: bool, max_chars: int):
    if harness == "codex":
        if record.get("type") != "response_item":
            return
        p = record.get("payload", {})
        kind = p.get("type")
        if kind == "message" and p.get("role") in ("user", "assistant"):
            for _, text in blocks_text(p.get("content"), tools, max_chars):
                if text.strip() and not NOISE.match(text):
                    yield p["role"], text.strip()
        elif tools and kind in ("function_call", "custom_tool_call"):
            yield "tool", clip(f"{p.get('name')}: {p.get('arguments') or p.get('input')}", max_chars)
        elif tools and kind in ("function_call_output", "custom_tool_call_output"):
            yield "tool result", clip(str(p.get("output")), max_chars)
        return
    role = record.get("role") or record.get("type")
    if role not in ("user", "assistant") or record.get("isMeta"):
        return
    message = record.get("message") or {}
    for kind, text in blocks_text(message.get("content"), tools, max_chars):
        if not text.strip() or (kind == "text" and NOISE.match(text)):
            continue
        if harness == "cursor":
            text = re.sub(r"</?user_query>", "", text)
        yield (role if kind == "text" else kind), text.strip()


# Store ----------------------------------------------------------------------

def repository_root(cwd: Path) -> Path:
    """The main checkout, so every worktree of one repository shares a store."""
    try:
        common = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=cwd, capture_output=True, text=True, timeout=10,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        common = ""
    if not common:
        return cwd
    common_path = Path(common).resolve()
    return common_path.parent if common_path.name == ".git" else common_path


def cmd_store(args: argparse.Namespace) -> None:
    root_dir = repository_root(Path(args.cwd or os.getcwd()).resolve())
    base = os.environ.get("PSTACK_STATE_HOME")
    root = Path(base).expanduser() if base else Path(
        os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "pstack"
    digest = hashlib.sha256(str(root_dir).encode()).hexdigest()[:8]
    store = root / f"{root_dir.name}-{digest}"
    store.mkdir(parents=True, exist_ok=True)
    print(store)


def main() -> None:
    parser = argparse.ArgumentParser(prog="pstack", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    models = sub.add_parser("models")
    models.add_argument("action", choices=["get", "show", "detect", "probe", "path"])
    models.add_argument("role", nargs="*")
    models.add_argument("--json", action="store_true")
    models.add_argument("--default", action="store_true", help="get: ignore the config")
    models.set_defaults(func=cmd_models)

    seat = sub.add_parser("seat")
    seat.add_argument("slug")
    seat.add_argument("--prompt-file", required=True)
    seat.add_argument("--out", required=True, help="file for the seat's final message")
    seat.add_argument("--read-only", action="store_true")
    seat.add_argument("--cwd")
    seat.add_argument("--dry-run", action="store_true")
    seat.set_defaults(func=cmd_seat)

    transcripts = sub.add_parser("transcripts")
    transcripts.add_argument("action", choices=["list", "current", "show"])
    transcripts.add_argument("file", nargs="?")
    transcripts.add_argument("--cwd")
    transcripts.add_argument("--harness", choices=["all", *SOURCES], default="all")
    transcripts.add_argument("--kind", choices=["all", "session", "subagent", "headless"],
                             default="all", help="headless means `claude -p` / `codex exec` runs, seats included")
    transcripts.add_argument("--since", type=float, help="only transcripts touched in the last DAYS")
    transcripts.add_argument("--limit", type=int, default=20, help="0 for no limit")
    transcripts.add_argument("--all-workspaces", action="store_true")
    transcripts.add_argument("--paths", action="store_true", help="print only paths")
    transcripts.add_argument("--tools", action="store_true")
    transcripts.add_argument("--max-chars", type=int, default=0,
                             help="show: clip each tool call and result (0 keeps them whole)")
    transcripts.set_defaults(func=cmd_transcripts)

    store = sub.add_parser("store")
    store.add_argument("--cwd")
    store.set_defaults(func=cmd_store)

    args = parser.parse_args()
    if getattr(args, "action", None) == "get" and args.command == "models" and not args.role:
        parser.error("models get needs a ROLE")
    args.func(args)


if __name__ == "__main__":
    main()
