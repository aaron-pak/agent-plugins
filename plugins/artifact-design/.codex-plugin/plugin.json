{
  "name": "artifact-design",
  "description": "Claude Code's artifact-design, artifact-diagramming and dataviz skills for HTML artifacts, with Artifact and ArtifactCheck MCP tools that publish and preview them on this machine. From Anthropic's Claude Code.",
  "author": {
    "name": "Anthropic"
  },
  "skills": "./skills/",
  "mcpServers": {
    "artifact": {
      "command": "node",
      "args": ["mcp/server.mjs"],
      "cwd": ".",
      "env_vars": [
        "ARTIFACTS_DIR",
        "ARTIFACT_OPEN",
        "ARTIFACT_PREVIEW",
        "ARTIFACT_PREVIEW_CA",
        "PLAYWRIGHT_BROWSERS_PATH",
        "XDG_CACHE_HOME",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XAUTHORITY",
        "XDG_RUNTIME_DIR",
        "XDG_CURRENT_DESKTOP",
        "DBUS_SESSION_BUS_ADDRESS"
      ],
      "omit_tools_from": ["deferred", "code_mode"]
    }
  }
}
