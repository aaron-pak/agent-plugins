{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "if": "Write(//**/artifact-drafts*/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-drafts.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(//**/artifact-drafts*/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-drafts.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/artifact-drafts*/**)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-drafts.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-drafts.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
